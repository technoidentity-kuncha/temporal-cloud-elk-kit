+<script lang="ts">
+  import { goto } from '$app/navigation';
+  import { base } from '$app/paths';
+  import { page } from '$app/state';
+
+  import PageTitle from '$lib/components/page-title.svelte';
+  import Button from '$lib/holocene/button.svelte';
+  import Input from '$lib/holocene/input/input.svelte';
+  import {
+    fetchS3ArchiveNamespaces,
+    fetchS3ArchiveRuns,
+  } from '$lib/services/s3-archive-service';
+
+  const namespaceParam = $derived(page.url.searchParams.get('namespace') ?? '');
+  const workflowParam = $derived(page.url.searchParams.get('workflowId') ?? '');
+
+  let namespace = $state(page.url.searchParams.get('namespace') ?? '');
+  let workflowId = $state(page.url.searchParams.get('workflowId') ?? '');
+
+  const namespaces = fetchS3ArchiveNamespaces().then((list) => {
+    if (!namespace && list.length) namespace = list[0];
+    return list;
+  });
+
+  const runs = $derived(
+    namespaceParam && workflowParam
+      ? fetchS3ArchiveRuns(namespaceParam, workflowParam)
+      : Promise.resolve(null),
+  );
+
+  const search = (event: SubmitEvent) => {
+    event.preventDefault();
+    const params = new URLSearchParams({
+      namespace,
+      workflowId: workflowId.trim(),
+    });
+    goto(`${base}/s3-archive?${params}`);
+  };
+
+  const historyHref = (runId: string): string =>
+    `${base}/s3-archive/namespaces/${encodeURIComponent(namespaceParam)}/workflows/${encodeURIComponent(workflowParam)}/${encodeURIComponent(runId)}/history`;
+
+  const formatTime = (value: string): string =>
+    value ? new Date(value).toLocaleString() : '';
+</script>
+
+<PageTitle title="S3 Archive" url={page.url.href} />
+
+<h1 class="text-2xl font-medium">Archived workflows</h1>
+
+<form class="flex flex-wrap items-end gap-3" onsubmit={search}>
+  <label class="flex flex-col gap-1 text-sm">
+    Namespace
+    <select
+      class="surface-primary border-subtle h-10 min-w-64 rounded border px-2"
+      bind:value={namespace}
+      data-testid="s3-archive-namespace"
+    >
+      {#await namespaces then list}
+        {#each list as option (option)}
+          <option value={option}>{option}</option>
+        {/each}
+      {/await}
+    </select>
+  </label>
+  <div class="min-w-96 flex-1">
+    <Input
+      id="s3-archive-workflow-id"
+      label="Workflow ID"
+      placeholder="e.g. claim-123"
+      bind:value={workflowId}
+      required
+    />
+  </div>
+  <Button type="submit" data-testid="s3-archive-search">Search</Button>
+</form>
+
+{#await runs}
+  <p class="text-secondary">Loading runs…</p>
+{:then list}
+  {#if list && list.length === 0}
+    <p class="text-secondary">
+      No archived runs for <code>{workflowParam}</code> in {namespaceParam}.
+    </p>
+  {:else if list}
+    <table class="w-full text-left text-sm" data-testid="s3-archive-runs">
+      <thead class="border-subtle border-b">
+        <tr>
+          <th class="py-2">Status</th>
+          <th>Run ID</th>
+          <th>Type</th>
+          <th>Start</th>
+          <th>Close</th>
+        </tr>
+      </thead>
+      <tbody>
+        {#each list as run (run.runId)}
+          <tr class="border-subtle border-b">
+            <td class="py-2">{run.status}</td>
+            <td>
+              <a class="text-brand underline" href={historyHref(run.runId)}
+                >{run.runId}</a
+              >
+            </td>
+            <td>{run.workflowType}</td>
+            <td>{formatTime(run.startTime)}</td>
+            <td>{formatTime(run.closeTime)}</td>
+          </tr>
+        {/each}
+      </tbody>
+    </table>
+  {/if}
+{:catch error}
+  <p class="text-danger">Could not load runs: {error?.statusText ?? error}</p>
+{/await}

+<script lang="ts">
+  import { base } from '$app/paths';
+  import { page } from '$app/state';
+
+  import EventSummaryTable from '$lib/components/event/event-summary-table.svelte';
+  import PageTitle from '$lib/components/page-title.svelte';
+  import SkeletonWorkflow from '$lib/holocene/skeleton/workflow.svelte';
+  import { groupEvents } from '$lib/models/event-groups';
+  import { toEventHistory } from '$lib/models/event-history';
+  import { fetchS3ArchiveHistory } from '$lib/services/s3-archive-service';
+
+  const namespace = $derived(page.params.namespace ?? '');
+  const workflowId = $derived(page.params.workflow ?? '');
+  const runId = $derived(page.params.run ?? '');
+
+  const history = $derived(
+    fetchS3ArchiveHistory(namespace, workflowId, runId).then((events) =>
+      toEventHistory(events),
+    ),
+  );
+
+  const backHref = $derived(
+    `${base}/s3-archive?${new URLSearchParams({ namespace, workflowId })}`,
+  );
+
+  const blockLiveLinks = (event: MouseEvent) => {
+    const link = (event.target as HTMLElement | null)?.closest('a');
+    if (link?.getAttribute('href')?.startsWith(`${base}/namespaces/`)) {
+      event.preventDefault();
+      event.stopPropagation();
+    }
+  };
+</script>
+
+<PageTitle title={`S3 Archive | ${workflowId}`} url={page.url.href} />
+
+<a class="text-sm text-brand underline" href={backHref}>← Back to runs</a>
+<div class="flex flex-col gap-1">
+  <h1 class="text-2xl font-medium" data-testid="s3-archive-workflow-id">
+    {workflowId}
+  </h1>
+  <p class="text-sm text-secondary">
+    {namespace} · run {runId}
+  </p>
+</div>
+
+{#await history}
+  <SkeletonWorkflow />
+{:then events}
+  {@const groups = groupEvents(events, 'ascending', [], [])}
+  <div onclickcapture={blockLiveLinks} role="presentation">
+    <EventSummaryTable items={events} {groups} />
+  </div>
+{:catch error}
+  <p class="text-danger">
+    Could not load history: {error?.statusText ?? error}
+  </p>
+{/await}

diff --git a/server/server/api/s3archive.go b/server/server/api/s3archive.go
new file mode 100644
index 0000000..472d79a
--- /dev/null
+++ b/server/server/api/s3archive.go
@@ -0,0 +1,223 @@
+package api
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"os"
+	"regexp"
+	"sort"
+	"strings"
+	"sync"
+
+	"github.com/aws/aws-sdk-go-v2/aws"
+	awsconfig "github.com/aws/aws-sdk-go-v2/config"
+	"github.com/aws/aws-sdk-go-v2/service/s3"
+	"github.com/aws/aws-sdk-go-v2/service/s3/types"
+	"github.com/labstack/echo/v4"
+
+	"github.com/temporalio/ui-server/v2/server/auth"
+	"github.com/temporalio/ui-server/v2/server/config"
+)
+
+const (
+	S3ArchiveNamespacesUrl = "/s3-archive/namespaces"
+	S3ArchiveRunsUrl       = "/s3-archive/namespaces/:namespace/workflows/:workflow/runs"
+	S3ArchiveHistoryUrl    = "/s3-archive/namespaces/:namespace/workflows/:workflow/runs/:runid/history"
+)
+
+var (
+	s3ArchiveNamespacePattern = regexp.MustCompile(`^[A-Za-z0-9._-]+$`)
+	s3ArchiveRunIDPattern     = regexp.MustCompile(`^[A-Za-z0-9-]+$`)
+)
+
+type S3ArchiveRun struct {
+	WorkflowID   string `json:"workflowId"`
+	RunID        string `json:"runId"`
+	WorkflowType string `json:"workflowType"`
+	Status       string `json:"status"`
+	StartTime    string `json:"startTime"`
+	CloseTime    string `json:"closeTime"`
+}
+
+type s3Archive struct {
+	bucket string
+	prefix string
+	client *s3.Client
+}
+
+var (
+	s3ArchiveOnce     sync.Once
+	s3ArchiveInstance *s3Archive
+	s3ArchiveErr      error
+)
+
+func getS3Archive(ctx context.Context) (*s3Archive, error) {
+	s3ArchiveOnce.Do(func() {
+		bucket := os.Getenv("S3_ARCHIVE_BUCKET")
+		if bucket == "" {
+			s3ArchiveErr = errors.New("S3 archive is not configured (S3_ARCHIVE_BUCKET)")
+			return
+		}
+		prefix := strings.Trim(os.Getenv("S3_ARCHIVE_PREFIX"), "/")
+		if prefix == "" {
+			prefix = "archive"
+		}
+		var opts []func(*awsconfig.LoadOptions) error
+		if region := os.Getenv("S3_ARCHIVE_REGION"); region != "" {
+			opts = append(opts, awsconfig.WithRegion(region))
+		}
+		cfg, err := awsconfig.LoadDefaultConfig(ctx, opts...)
+		if err != nil {
+			s3ArchiveErr = err
+			return
+		}
+		s3ArchiveInstance = &s3Archive{bucket: bucket, prefix: prefix, client: s3.NewFromConfig(cfg)}
+	})
+	return s3ArchiveInstance, s3ArchiveErr
+}
+
+// encodeS3ArchiveSegment percent-encodes everything except RFC 3986 unreserved characters,
+// matching the converter's Python urllib.parse.quote(value, safe="").
+func encodeS3ArchiveSegment(value string) string {
+	var b strings.Builder
+	for _, c := range []byte(value) {
+		if (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~' {
+			b.WriteByte(c)
+		} else {
+			fmt.Fprintf(&b, "%%%02X", c)
+		}
+	}
+	return b.String()
+}
+
+func s3ArchiveParams(c echo.Context) (namespace, workflowID string, err error) {
+	namespace = c.Param("namespace")
+	workflowID, err = url.QueryUnescape(c.Param("workflow"))
+	if err != nil || workflowID == "" || !s3ArchiveNamespacePattern.MatchString(namespace) {
+		return "", "", echo.NewHTTPError(http.StatusBadRequest, "invalid namespace or workflow ID")
+	}
+	return namespace, workflowID, nil
+}
+
+func s3ArchivePrepare(c echo.Context, cfgProvider *config.ConfigProviderWithRefresh) (*s3Archive, error) {
+	if err := auth.ValidateAuthHeaderExists(c, cfgProvider); err != nil {
+		return nil, err
+	}
+	archive, err := getS3Archive(c.Request().Context())
+	if err != nil {
+		return nil, echo.NewHTTPError(http.StatusServiceUnavailable, err.Error())
+	}
+	return archive, nil
+}
+
+func S3ArchiveNamespacesHandler(cfgProvider *config.ConfigProviderWithRefresh) echo.HandlerFunc {
+	return func(c echo.Context) error {
+		archive, err := s3ArchivePrepare(c, cfgProvider)
+		if err != nil {
+			return err
+		}
+		out, err := archive.client.ListObjectsV2(c.Request().Context(), &s3.ListObjectsV2Input{
+			Bucket:    aws.String(archive.bucket),
+			Prefix:    aws.String(archive.prefix + "/"),
+			Delimiter: aws.String("/"),
+		})
+		if err != nil {
+			return echo.NewHTTPError(http.StatusBadGateway, err.Error())
+		}
+		namespaces := []string{}
+		for _, p := range out.CommonPrefixes {
+			name := strings.TrimSuffix(strings.TrimPrefix(aws.ToString(p.Prefix), archive.prefix+"/"), "/")
+			if !strings.HasPrefix(name, "_") {
+				namespaces = append(namespaces, name)
+			}
+		}
+		return c.JSON(http.StatusOK, map[string][]string{"namespaces": namespaces})
+	}
+}
+
+func S3ArchiveRunsHandler(cfgProvider *config.ConfigProviderWithRefresh) echo.HandlerFunc {
+	return func(c echo.Context) error {
+		archive, err := s3ArchivePrepare(c, cfgProvider)
+		if err != nil {
+			return err
+		}
+		namespace, workflowID, err := s3ArchiveParams(c)
+		if err != nil {
+			return err
+		}
+		ctx := c.Request().Context()
+		prefix := fmt.Sprintf("%s/%s/%s/", archive.prefix, namespace, encodeS3ArchiveSegment(workflowID))
+		var objects []types.Object
+		pager := s3.NewListObjectsV2Paginator(archive.client, &s3.ListObjectsV2Input{
+			Bucket:    aws.String(archive.bucket),
+			Prefix:    aws.String(prefix),
+			Delimiter: aws.String("/"),
+		})
+		for pager.HasMorePages() {
+			page, err := pager.NextPage(ctx)
+			if err != nil {
+				return echo.NewHTTPError(http.StatusBadGateway, err.Error())
+			}
+			objects = append(objects, page.Contents...)
+		}
+
+		runs := make([]S3ArchiveRun, len(objects))
+		var wg sync.WaitGroup
+		sem := make(chan struct{}, 8)
+		for i, obj := range objects {
+			wg.Add(1)
+			go func(i int, key string) {
+				defer wg.Done()
+				sem <- struct{}{}
+				defer func() { <-sem }()
+				run := S3ArchiveRun{WorkflowID: workflowID, RunID: strings.TrimSuffix(strings.TrimPrefix(key, prefix), ".json")}
+				head, err := archive.client.HeadObject(ctx, &s3.HeadObjectInput{Bucket: aws.String(archive.bucket), Key: aws.String(key)})
+				if err == nil {
+					run.WorkflowType = head.Metadata["workflow-type"]
+					run.Status = head.Metadata["status"]
+					run.StartTime = head.Metadata["start-time"]
+					run.CloseTime = head.Metadata["close-time"]
+				}
+				runs[i] = run
+			}(i, aws.ToString(obj.Key))
+		}
+		wg.Wait()
+		sort.Slice(runs, func(a, b int) bool { return runs[a].CloseTime > runs[b].CloseTime })
+		return c.JSON(http.StatusOK, map[string][]S3ArchiveRun{"runs": runs})
+	}
+}
+
+func S3ArchiveHistoryHandler(cfgProvider *config.ConfigProviderWithRefresh) echo.HandlerFunc {
+	return func(c echo.Context) error {
+		archive, err := s3ArchivePrepare(c, cfgProvider)
+		if err != nil {
+			return err
+		}
+		namespace, workflowID, err := s3ArchiveParams(c)
+		if err != nil {
+			return err
+		}
+		runID := c.Param("runid")
+		if !s3ArchiveRunIDPattern.MatchString(runID) {
+			return echo.NewHTTPError(http.StatusBadRequest, "invalid run ID")
+		}
+		key := fmt.Sprintf("%s/%s/%s/%s.json", archive.prefix, namespace, encodeS3ArchiveSegment(workflowID), runID)
+		obj, err := archive.client.GetObject(c.Request().Context(), &s3.GetObjectInput{Bucket: aws.String(archive.bucket), Key: aws.String(key)})
+		if err != nil {
+			var missing *types.NoSuchKey
+			if errors.As(err, &missing) {
+				return echo.NewHTTPError(http.StatusNotFound, "archived run not found")
+			}
+			return echo.NewHTTPError(http.StatusBadGateway, err.Error())
+		}
+		defer obj.Body.Close()
+		c.Response().Header().Set(echo.HeaderContentType, echo.MIMEApplicationJSON)
+		c.Response().WriteHeader(http.StatusOK)
+		_, err = io.Copy(c.Response().Writer, obj.Body)
+		return err
+	}
+}

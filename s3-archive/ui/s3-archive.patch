+++ b/src/lib/services/s3-archive-service.ts
@@ -0,0 +1,54 @@
+import type { HistoryEvent } from '$lib/types/events';
+import { requestFromAPI } from '$lib/utilities/request-from-api';
+import { base } from '$lib/utilities/route-for-api';
+
+export type S3ArchiveRun = {
+  workflowId: string;
+  runId: string;
+  workflowType: string;
+  status: string;
+  startTime: string;
+  closeTime: string;
+};
+
+const route = (path: string): string => `${base()}/api/v1/s3-archive/${path}`;
+
+const workflowPath = (namespace: string, workflowId: string): string =>
+  `namespaces/${encodeURIComponent(namespace)}/workflows/${encodeURIComponent(workflowId)}`;
+
+export const fetchS3ArchiveNamespaces = async (
+  request = fetch,
+): Promise<string[]> => {
+  const response = await requestFromAPI<{ namespaces: string[] }>(
+    route('namespaces'),
+    { request },
+  );
+  return response?.namespaces ?? [];
+};
+
+export const fetchS3ArchiveRuns = async (
+  namespace: string,
+  workflowId: string,
+  request = fetch,
+): Promise<S3ArchiveRun[]> => {
+  const response = await requestFromAPI<{ runs: S3ArchiveRun[] }>(
+    route(`${workflowPath(namespace, workflowId)}/runs`),
+    { request },
+  );
+  return response?.runs ?? [];
+};
+
+export const fetchS3ArchiveHistory = async (
+  namespace: string,
+  workflowId: string,
+  runId: string,
+  request = fetch,
+): Promise<HistoryEvent[]> => {
+  const response = await requestFromAPI<{ events: HistoryEvent[] }>(
+    route(
+      `${workflowPath(namespace, workflowId)}/runs/${encodeURIComponent(runId)}/history`,
+    ),
+    { request },
+  );
+  return response?.events ?? [];
+};

# Temporal Cloud namespace (API-key auth). Regional endpoint shown in the Cloud UI namespace page.
TEMPORAL_ADDRESS=<region>.<cloud>.api.temporal.io:7233
TEMPORAL_NAMESPACE=<namespace>.<account>
TEMPORAL_API_KEY=<api key with access to the namespace>

# Temporal Cloud metrics endpoint key: service account with the account-level "Metrics Read-Only" role.
TEMPORAL_METRICS_API_KEY=<metrics api key>

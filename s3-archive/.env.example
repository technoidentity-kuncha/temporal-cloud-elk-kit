# Copy to .env (gitignored). Values are placeholders.

# Namespace the converter Schedule and worker run in (its own namespace is recommended)
TEMPORAL_ADDRESS=<region>.<cloud>.api.temporal.io:7233
TEMPORAL_NAMESPACE=<converter-namespace>.<account-id>
TEMPORAL_API_KEY=<api-key>

# Namespace whose workflows are exported, and the export bucket
EXPORTED_NAMESPACE=<exported-namespace>.<account-id>
EXPORT_BUCKET=<export-bucket>
# Optional: write the archive to another bucket (defaults to EXPORT_BUCKET) / prefix
ARCHIVE_BUCKET=
ARCHIVE_PREFIX=archive

AWS_REGION=<bucket-region>
AWS_PROFILE=<aws-profile>

# Compose selection persists across startup, load, sweep, and teardown. See elk/README.md.
COMPOSE_FILE=docker-compose.yml

# Temporal Cloud namespace (API-key auth). Regional endpoint shown in the Cloud UI namespace page.
TEMPORAL_ADDRESS=<region>.<cloud>.api.temporal.io:7233
TEMPORAL_NAMESPACE=<namespace>.<account>
TEMPORAL_API_KEY=<api key with access to the namespace>

# Temporal Cloud metrics endpoint key: service account with the account-level "Metrics Read-Only" role.
TEMPORAL_METRICS_API_KEY=<metrics api key>

# Optional TOML profiles (remove TEMPORAL_ADDRESS above; namespace must match TOML).
# COMPOSE_FILE=docker-compose.yml:docker-compose.auth.yml
# For Spring Boot append :docker-compose.spring.yml to the selected COMPOSE_FILE.
# TEMPORAL_CONFIG_FILE=/etc/temporal/temporal.toml
# TEMPORAL_PROFILE=cloud-api-key
# For mTLS select cloud-mtls and remove TEMPORAL_API_KEY above.
# Alternatively, TLS file overrides (container paths):
# TEMPORAL_TLS_CLIENT_CERT_PATH=/run/temporal-certs/client.pem
# TEMPORAL_TLS_CLIENT_KEY_PATH=/run/temporal-certs/client.key
